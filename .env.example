# Copie este arquivo para ".env" e ajuste. Só o bloco "MODELO" é obrigatório.

# ======================= MODELO (qualquer marca) =======================
# MODEL_PROVIDER: anthropic (padrão) | nvidia | openai | ollama | openai-compatible

# --- Exemplo NVIDIA (build.nvidia.com) ---
MODEL_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-cole-sua-chave-aqui
MODEL_NAME=meta/llama-3.1-70b-instruct
# (use "npm run models" para ver os modelos disponíveis; nem todo modelo aceita ferramentas)

# --- Exemplo NVIDIA com visão: Nemotron 3 Nano Omni Reasoning ---
# Modelo multimodal (texto, imagem, vídeo, áudio) com etapa de raciocínio.
# MODEL_PROVIDER=nvidia
# NVIDIA_API_KEY=nvapi-cole-sua-chave-aqui
# MODEL_NAME=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# MODEL_VISION=true
# TOOLS=computer
# MODEL_MAX_TOKENS=65536
# MODEL_REASONING_BUDGET=16384
# MODEL_TEMPERATURE=0.6
# MODEL_TOP_P=0.95

# --- Exemplo Anthropic ---
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sua-chave-aqui
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Exemplo local (Ollama / LM Studio / vLLM) ---
# MODEL_PROVIDER=ollama
# MODEL_NAME=llama3.1
# (para outro servidor: MODEL_PROVIDER=openai-compatible e MODEL_BASE_URL=http://localhost:1234/v1)

# Ajustes finos do modelo (só se precisar):
# MODEL_VISION=true            # o modelo aceita imagens? (necessário para TOOLS=computer)
# MODEL_TOOLS=false            # o modelo NÃO chama ferramentas: o agente só conversa
# MODEL_SYSTEM_MODE=inline     # modelo que não aceita o papel "system"
# MODEL_MAX_TOKENS_PARAM=max_completion_tokens
# MODEL_TIMEOUT_SECONDS=120
# MODEL_MAX_RETRIES=2
# MODEL_MAX_TOKENS=4096          # limite de tokens na resposta (aumente para modelos "reasoning")
# MODEL_TEMPERATURE=1            # 0 a 2 (Anthropic) ou conforme o provedor
# MODEL_TOP_P=1
# MODEL_REASONING_BUDGET=16384   # só NVIDIA/NIM, modelos "reasoning" (ex.: Nemotron Omni Reasoning)

# ======================= CADEIA DE MODELOS (fallback) =======================
# Opcional: modelos reserva usados quando o principal falha (limite de uso 429, timeout,
# erro do servidor, modelo indisponível 404). Erros de chave/configuração continuam
# falhando na hora (trocar de modelo só esconderia o problema).
# Formato: provider:modelo — separados por vírgula; tags opcionais entre colchetes:
#   [+vision] aceita imagens | [-vision] não aceita | [+tools] usa ferramentas | [-tools] não usa
# Cada provider usa a chave já definida neste arquivo (NVIDIA_API_KEY, ANTHROPIC_API_KEY…).
# FALLBACK_MODELS=nvidia:meta/llama-3.3-70b-instruct,nvidia:nvidia/nemotron-3-nano-omni-30b-a3b-reasoning[+vision],ollama:llama3.1

# Modelo que falhou entra em "cooldown" (descanso) e as requisições vão para o próximo da
# cadeia; depois do descanso ele é testado de novo. Falhas seguidas dobram o tempo.
# MODEL_COOLDOWN_SECONDS=60        # descanso após uma falha (0 = desliga o cooldown)
# MODEL_COOLDOWN_MAX_SECONDS=900   # teto do descanso

# ======================= AGENTE =======================
# Pasta onde o agente pode ler/escrever (vazio = pasta atual)
WORKSPACE_DIR=
# Ferramentas (padrão: read_file,list_directory,write_file,edit_file). Extras: execute_command, computer, web, places
# "web" liga busca, leitura de páginas e abrir abas no navegador (abrir abas não pede confirmação).
TOOLS=
MAX_STEPS=
AGENT_LOG_FILE=

# ======================= GOOGLE PLACES (opcional: TOOLS=places) =======================
# Busca de estabelecimentos/empresas (futuros leads). Usa a Places API (New) do Google:
# exige projeto com FATURAMENTO ATIVO. Cada busca é paga por requisição (não por resultado):
# SKU "Text Search Enterprise + Atmosphere" — 1.000 buscas GRATIS por mês, depois US$ 40/1.000.
# Detalhes e proteções: docs/plano-places-leads.md
# GOOGLE_PLACES_API_KEY=
# PLACES_LANGUAGE=pt-BR          # idioma dos resultados (opcional)

# ======================= MODO VOZ (npm run voice) =======================
# Palavras que chamam o agente
# WAKE_WORDS=jarvis,sexta-feira,batman
# Segundos de silêncio para enviar a mensagem
# VOICE_SILENCE_SECONDS=10
# Idioma do reconhecimento e da voz
# VOICE_LANG=pt-BR

# Voz do agente. Padrão: voz do navegador (grátis, nada a instalar; o Edge tem as melhores em pt-BR).
# VOICE_REPLIES=auto           # auto = fala quando você chama por voz | off = nunca fala
# VOICE_BARGE_IN=any           # interromper falando: any | wake (só com a palavra-chave) | off
# VOICE_RATE=1.0
# VOICE_PITCH=1.0
# VOICE_NAME=antonio           # parte do nome da voz preferida
# VOICE_TITLE=J.A.R.V.I.S.

# Voz de mais qualidade com um servidor Kokoro LOCAL (grátis, roda na sua máquina):
# TTS_PROVIDER=kokoro
# TTS_VOICE=pm_alex            # "npm run voices" lista as vozes do seu servidor
# TTS_BASE_URL=http://localhost:8880/v1
